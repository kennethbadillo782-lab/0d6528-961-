# No se necesitan secretos reales para las pruebas Node y SQL aisladas.
# Para despliegue remoto, configurar en el gestor de secretos de Supabase.
API_IP_SALT=REEMPLAZAR_EN_EL_GESTOR_DE_SECRETOS
# No usar ALLOWED_IP_CIDRS hasta verificar la cabecera que fija el proxy.
# CLIENT_IP_HEADER=
# ALLOWED_IP_CIDRS=
# IMAGE_HOST_ALLOWLIST=alicdn.com,geilicdn.com,photo.yupoo.com
# Nunca fijar IMAGE_HOST_ALLOWLIST=* con claves que pueden leer.
